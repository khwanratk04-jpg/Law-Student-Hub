rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /workspace/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shared course reviews visible to every authenticated user.
    match /publicCourseReviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.authorUid == request.auth.uid;
    }

    // Shared exam comments: all signed-in users can read; authors can create/delete their own.
    match /publicExamComments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid;
      allow delete, update: if request.auth != null
                            && resource.data.authorUid == request.auth.uid;
    }
  }
}
